[ Para [ Span ( "chapter.xhtml" , [] , [] ) [] ]
, Div
    ( "chapter.xhtml_intro" , [ "section" ] , [] )
    [ Header
        1
        ( "" , [] , [] )
        [ Str "Blockquote"
        , Space
        , Str "List"
        , Space
        , Str "Spine"
        ]
    , BlockQuote
        [ Para
            [ Str "Quoted"
            , Space
            , Str "EPUB"
            , Space
            , Str "reader"
            , Space
            , Str "text."
            ]
        ]
    , OrderedList
        ( 3 , UpperAlpha , DefaultDelim )
        [ [ Plain [ Str "Third" , Space , Str "alpha" ] ]
        , [ Plain [ Str "Fourth" , Space , Str "alpha" ] ]
        ]
    , BulletList
        [ [ Plain [ Str "Nested" , Space , Str "bullet" ] ] ]
    ]
]
