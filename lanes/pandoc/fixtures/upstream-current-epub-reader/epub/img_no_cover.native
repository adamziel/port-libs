Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "author"
            , MetaList
                [ MetaInlines [ Str "Ori Idan" ]
                , MetaInlines [ Str "Matt Garrish" ]
                , MetaInlines [ Str "Marisa DeMeglio" ]
                , MetaInlines [ Str "Toshiaki Koike" ]
                , MetaInlines [ Str "Vincent Gros" ]
                , MetaInlines [ Str "Markus Gylling" ]
                ]
            )
          , ( "description"
            , MetaInlines
                [ Str
                    "Tests for Content Documents in a reflowable context [UNDER CONSTRUCTION]"
                ]
            )
          , ( "identifier"
            , MetaInlines
                [ Str "com.github.epub-testsuite.epub30-test-0100" ]
            )
          , ( "language"
            , MetaList
                [ MetaInlines [ Str "jp" ] , MetaInlines [ Str "en" ] ]
            )
          , ( "title"
            , MetaInlines
                [ Str "EPUBTEST 0100 - Reflowable Content Tests" ]
            )
          ]
    }
  [ Para [ Span ( "content-images-001.xhtml" , [] , [] ) [] ]
