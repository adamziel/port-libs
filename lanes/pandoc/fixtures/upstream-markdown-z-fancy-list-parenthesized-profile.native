[ OrderedList
    ( 1 , LowerRoman , TwoParens )
    [ [ Plain [ Str "roman" , Space , Str "one" ] ]
    , [ Plain [ Str "roman" , Space , Str "two" ] ]
    ]
, OrderedList
    ( 1 , LowerAlpha , TwoParens )
    [ [ Plain [ Str "alpha" , Space , Str "one" ] ]
    , [ Plain [ Str "alpha" , Space , Str "two" ] ]
    ]
]
