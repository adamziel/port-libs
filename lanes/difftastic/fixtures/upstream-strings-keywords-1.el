(defconst hack--keyword-regex
  ;; Keywords, based on hphp.ll.
  ;; We don't highlight endforeach etc, as they're syntax errors
  ;; in full_fidelity_syntax_error.ml
  (regexp-opt
   '("exit"
     "die"
     "const"
     "return"
     "yield"
     "from"
     "try"
     "catch"
     "finally"
     "using"
     "throw"
     "if"
     "else"
     "while"
     "do"
     "for"
     "foreach"
     "declare"
     "enddeclare"
     "instanceof"
     "as"
     "super"
     "switch"
     "case"
     "default"
     "break"
     "continue"
     "goto"
     "echo"
     "print"
     "class"
     "interface"
     "trait"
     "insteadof"
     "extends"
     "implements"
     "enum"
     "attribute"
     "category"
     "children"
     "required"
     "function"
     "new"
     "clone"
     "var"
     "callable"
     "eval"
     "include"
     "include_once"
     "require"
     "require_once"
     "namespace"
     "use"
     "global"
     "isset"
     "empty"
     "__halt_compiler"
     "__compiler_halt_offset__"
     "static"
     "abstract"
     "final"
     "private"
     "protected"
     "public"
     "unset"
     "==>"
     "list"
     "array"
     "OR"
     "AND"
     "XOR"
     "dict"
     "keyset"
     "shape"
     "type"
     "newtype"
     "where"
     "await"
     "vec"
     "varray"
     "darray"
     "inout"
     "async"
     "tuple"
     "__CLASS__"
     "__TRAIT__"
     "__FUNCTION__"
     "__METHOD__"
     "__LINE__"
     "__FILE__"
     "__DIR__"
     "__NAMESPACE__"
     "__COMPILER_FRONTEND__"
     ;; Treat self:: and static:: as keywords.
     "self"
     "parent")
   'symbols))
